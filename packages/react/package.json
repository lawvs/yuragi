{
  "name": "@type-shards/react",
  "version": "0.0.0",
  "type": "module",
  "peerDependencies": {
    "react": "19.3.0-canary-a7cce7b3-20260617",
    "react-dom": "19.3.0-canary-a7cce7b3-20260617"
  },
  "dependencies": {
    "@type-shards/core": "workspace:*",
    "@type-shards/wasm": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/wasm.tsx --format esm --dts --sourcemap --clean --target es2022 --external react",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "19.3.0-canary-a7cce7b3-20260617",
    "react-dom": "19.3.0-canary-a7cce7b3-20260617",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@yuragi-labs/react",
  "version": "0.1.0",
  "description": "React components for rendering animated Yuragi text from static or runtime-compiled outlines.",
  "keywords": [
    "yuragi",
    "react",
    "typography",
    "svg",
    "animation",
    "text-effects"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawvs/yuragi.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/lawvs/yuragi/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/lawvs/yuragi/issues"
  },
  "type": "module",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@yuragi-labs/core": "workspace:*",
    "@yuragi-labs/wasm": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown src/index.ts src/static.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

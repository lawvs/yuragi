{
  "name": "@type-shards/core",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": ["./dist/style.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && cp src/style.css dist/style.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}

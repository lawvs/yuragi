{
  "name": "@yuragi-labs/core",
  "version": "0.1.0",
  "description": "Core types, layout, SVG, animation, and styles for Yuragi text effects.",
  "keywords": ["yuragi", "typography", "svg", "animation", "text-effects"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawvs/yuragi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lawvs/yuragi/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/lawvs/yuragi/issues"
  },
  "type": "module",
  "sideEffects": ["./dist/style.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown && cp src/style.css dist/style.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@yuragi-labs/wasm",
  "version": "0.1.0",
  "description": "WebAssembly font compiler for generating Yuragi text outlines at runtime.",
  "keywords": ["yuragi", "webassembly", "wasm", "font", "typography", "svg"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawvs/yuragi.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://github.com/lawvs/yuragi/tree/main/packages/wasm#readme",
  "bugs": {
    "url": "https://github.com/lawvs/yuragi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./yuragi_wasm_compiler.wasm": "./dist/yuragi_wasm_compiler.wasm"
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm build:wasm && tsdown src/index.ts src/runtime.ts && cp wasm/yuragi_wasm_compiler.wasm dist/yuragi_wasm_compiler.wasm",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yuragi-labs/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@type-shards/wasm",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./type_shards_wasm_compiler.wasm": "./dist/type_shards_wasm_compiler.wasm"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build-wasm.mjs && tsup src/index.ts src/runtime.ts --format esm --dts --sourcemap --clean --target es2022 && cp wasm/type_shards_wasm_compiler.wasm dist/type_shards_wasm_compiler.wasm",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@type-shards/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

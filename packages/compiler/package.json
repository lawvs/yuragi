{
  "name": "@yuragi-labs/compiler",
  "version": "0.4.0",
  "description": "Native build-time font compiler for generating Yuragi text outlines.",
  "license": "MIT",
  "keywords": [
    "yuragi",
    "font",
    "compiler",
    "typography",
    "svg",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawvs/yuragi.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/lawvs/yuragi/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/lawvs/yuragi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "rust-toolchain.toml"
  ],
  "scripts": {
    "build": "tsdown",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yuragi-labs/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

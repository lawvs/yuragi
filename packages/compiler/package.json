{
  "name": "@yuragi/compiler",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "rust-toolchain.toml"
  ],
  "scripts": {
    "build": "tsup",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yuragi/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

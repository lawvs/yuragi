{
  "name": "@yuragi-labs/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "hero:generate": "tsx scripts/generate-hero-outline.ts",
    "predev": "pnpm wasm-lab:build",
    "dev": "vite",
    "build": "pnpm wasm-lab:build && tsc --noEmit && pnpm build:vite",
    "build:vite": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "wasm-lab:build": "pnpm --filter @yuragi-labs/core build"
  },
  "dependencies": {
    "@yuragi-labs/core": "workspace:*",
    "@yuragi-labs/react": "workspace:*",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@yuragi-labs/compiler": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

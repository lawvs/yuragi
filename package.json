{
  "name": "type-shards",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @type-shards/playground typecheck",
    "dev": "pnpm --filter @type-shards/playground dev",
    "playground:build": "pnpm --filter @type-shards/playground build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}

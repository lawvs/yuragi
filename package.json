{
  "name": "yuragi",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @yuragi-labs/playground typecheck",
    "dev": "pnpm --filter @yuragi-labs/playground dev",
    "playground:build": "pnpm --filter @yuragi-labs/playground build",
    "examples:build": "pnpm build && pnpm -r --filter './examples/*' build",
    "release:check": "pnpm examples:build && pnpm typecheck && pnpm test && node scripts/check-release.mts",
    "tegami": "node scripts/tegami.mts",
    "wasm-lab:build": "pnpm --filter @yuragi-labs/playground wasm-lab:build"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tegami": "1.2.5",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "undici": "7.28.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}

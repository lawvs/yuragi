{
  "name": "type-shards",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @type-shards/playground typecheck",
    "dev": "pnpm --filter @type-shards/playground dev",
    "playground:build": "pnpm --filter @type-shards/playground build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}

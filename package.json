{
  "name": "yuragi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @yuragi/playground typecheck",
    "dev": "pnpm --filter @yuragi/playground dev",
    "playground:build": "pnpm --filter @yuragi/playground build",
    "examples:build": "pnpm build && pnpm -r --filter './examples/*' build",
    "wasm-lab:build": "pnpm --filter @yuragi/playground wasm-lab:build"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "undici": "7.28.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
